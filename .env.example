# console-stack public — 复制为 .env 后填写。不要提交 .env。
# 安装步骤见 docs/install.md。

# 使用已发布镜像（推荐不可变 tag：sha-<public commit>）；留空则本地 build（target public）。
# CONSOLE_IMAGE=ghcr.io/isdoge/console-stack-public:sha-<commit>

# 宿主回环端口（容器内 8080）
CONSOLE_HTTP_PORT=8081

# Flask 会话密钥（随机长串）
SECRET_KEY=

# PostgreSQL：库名 / 管理员（仅迁移工具使用，密码在 ./secrets/pg-admin.password）
CONSOLE_PG_DB=console
CONSOLE_PG_ADMIN_USER=console_admin
# 运行账号（受限 DML，无 DDL/超级用户），由 `console-schema grant-app-role` 创建
CONSOLE_PG_USER=console_app
CONSOLE_PG_PASSWORD=

# 鉴权（内网默认关闭；对外暴露前务必开启并放到反代之后）
CONSOLE_AUTH_ENABLED=false
CONSOLE_AUTH_USER=admin
CONSOLE_AUTH_PASSWORD=

# Go agent 首次注册令牌（不配置则拒绝注册）
CONSOLE_MONITORING_ENROLL_TOKEN=

# normal | read_only
CONSOLE_MAINTENANCE_MODE=normal
