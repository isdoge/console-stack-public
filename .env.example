# 复制为 .env 后填入真实值
FLASK_ENV=production
SECRET_KEY=

# ---- 鉴权总开关（内网默认关闭）----
# false：Beszel 自动登录 + 控制台无需密码
# true ：Beszel 需手动登录 + 控制台 HTTP Basic Auth
CONSOLE_AUTH_ENABLED=false

# 仅 CONSOLE_AUTH_ENABLED=true 时生效
CONSOLE_AUTH_USER=admin
CONSOLE_AUTH_PASSWORD=

# 默认同源，不需要 CORS。仅本地前端开发时显式填写，多个 Origin 用逗号分隔。
# 示例：http://localhost:3000,http://127.0.0.1:3000
CONSOLE_CORS_ORIGINS=

# SSH 目标：全部走 Tailscale IP，跨设备/网络稳定，不依赖各机器 ~/.ssh/config 别名。
# 容器内 SSH key 与 known_hosts 走 .ssh-console/ 挂载（对应指纹已固化）。
#
# MACHINE_SSH_NAS：留空 = console 就在 NAS 本机跑（生产形态，走本机 docker）；
# 若从 mac/win 等开发机起 console，设成 root@<NAS Tailscale IP>。
# MACHINE_SSH_TXY / MACHINE_SSH_ALY：留空则回退到 machines.yaml 的 ssh 目标。
MACHINE_SSH_NAS=
MACHINE_SSH_TXY=root@100.64.0.30
MACHINE_SSH_ALY=root@100.64.0.40

# 私钥目录：容器内默认 /root/.ssh（由 .ssh-console/ 挂载而来），无需设置。
# 从 mac/win 开发机直跑时必须指向仓库内的 .ssh-console/，否则 machines.yaml 里
# 配了 ssh_key 的机器（us/kr/sg）会因 `-i /root/.ssh/xxx` 找不到文件而 publickey 失败。
# CONSOLE_SSH_KEY_DIR=/Users/<you>/Workspace/project/console-stack/.ssh-console

# 控制台探测间隔（秒）：健康检查、运行态和 PG 快照读取间隔，默认 600 = 10 分钟
CONSOLE_PROBE_INTERVAL=600

# 控制台对外地址（可选，用于生成绝对链接）
CONSOLE_PUBLIC_URL=

# Go agent 首次注册的管理员令牌；只在 NAS 私有 .env 配置，不写入 machines.yaml。
# 未配置时 /api/monitoring/v1/enrol 一律拒绝；ingest 使用注册后签发的独立 Bearer secret。
CONSOLE_MONITORING_ENROLL_TOKEN=

# 面板凭据可留在 NAS 宿主私有绝对文件中，避免进入 Git；部署前必须已存在。
# 未设置时兼容 ./console/panels.yaml；容器仍读取 /app/panels.yaml。
# CONSOLE_PANELS_HOST_PATH=/vol1/console-stack-data/private/panels.yaml

# 个人记账私有资料目录；默认 backend/data/pay（容器内 /app/data/pay）。
# 原始账单、参考分类表与上传归档不进 Git/镜像；Docker 中保持在既有 data 挂载下。
# CONSOLE_PAY_DATA_DIR=/app/data/pay

# ---- Workstation 功能（可选）----
# 配置后启用：自己仓库 Push 信息流（试验）/ Raindrop / RSS
# GITHUB_TOKEN 同时用于版本检查（version_service / version_sync）
GITHUB_TOKEN=          # GitHub API token（信息流：自己名下仓库 PushEvent）
RAINDROP_TOKEN=        # Raindrop.io API token（试验期默认不聚合）
RSS_URLS=              # RSS 源 URL，逗号分隔（试验期默认不聚合）

# 个人记账邮件工具（仅显式 mail-sync --execute 使用；默认不联网）
# PAY_IMAP_HOST=
# PAY_IMAP_USER=
# PAY_IMAP_AUTH=
# PAY_IMAP_FOLDER=INBOX
# PAY_IMAP_SENDER=

# ---- 存储引擎与 PostgreSQL（PG-04，提案 §6.4；PG-05 收口）----
# 目标态只有 postgres（§6.4 表：NAS/Mac/CI 三处都设 postgres）。
# 代码缺省值仍是 sqlite，但**它只让非财务模块走 legacy**：账本/续费域无条件走
# db.pg_transaction()，sqlite 下会直接报「缺少 PostgreSQL 配置」——不是可用的运行态。
# 所以漏设这个变量得到的是「账本不可用」的实例，不是「退回旧行为」的实例。
# `verify_deploy.py` 核验项 19 据此把 sqlite 判 FAIL（D3：无 SQLite 在线 fallback）；
# 割接前的验收用 `--skip 19`，割接后必须 19/19 PASS。
#
# PG-05 §11.5 V4-02：这三个键是**阶段配置**，必须显式在位——compose 已按目标态接线
# （storage_engine 缺省 postgres / instance_role 缺省 client / maintenance_mode
# 缺省 normal），割接时由外置控制器改写本文件：prepare 写 storage_engine=postgres
# 与 instance_role，freeze 写 maintenance_mode=read_only，open 时恢复。
CONSOLE_STORAGE_ENGINE=postgres
# authority = NAS 唯一自动采集；client = Mac（业务读写、不采集）；test = 隔离测试
CONSOLE_INSTANCE_ROLE=client
# normal 可写；read_only 显式维护模式（禁止全部业务写/文件发布/YAML 写/seed/采集）
CONSOLE_MAINTENANCE_MODE=normal
# B6-4：Console PG 为唯一监控业务来源；旧 Hub 已退役，不再提供运行时切换开关。
# PG 连接：NAS 用 compose 内部名 console-postgres；Mac 主路径 100.64.0.10（Tailscale），
# 备用 192.168.50.100（仅同一 LAN 时显式切换，仍是同一库）。密码独立私有值，
# NAS/Mac 各自独立运行账号（console_nas/console_mac），均无 DDL/超级用户权限。
# HOST/USER/PASSWORD 三键必填且必须非空：docker-compose.yml 用 ${VAR:?} 接线，缺失
# 会在 compose 解析期直接报错，而不是等容器起来由 D3 闸门 SystemExit。
CONSOLE_PG_HOST=100.64.0.10
CONSOLE_PG_PORT=5432
CONSOLE_PG_DB=console
CONSOLE_PG_USER=console_mac
# 占位值，必须换成真实私有密码。留空会让 compose 直接拒绝解析；填占位值则能起栈但
# 连不上库（PG 认证失败），两种都是显式失败——这正是想要的，不要为了「先跑起来」
# 而放宽 compose 的 :? 接线。
CONSOLE_PG_PASSWORD=replace-with-private-value
# 连接超时（秒），有界失败（D10）：不伪造零值、不无限等待
# CONSOLE_PG_CONNECT_TIMEOUT=5
# client 必填：NAS 的固定私网 origin（观测、YAML 管理、文件归档均使用）。
# 缺项、带路径/凭据/参数或指向自身时启动失败；authority/test 不要求此项。
# 不使用 Mac 预览地址。API health 同样核验本项；共享 PG 可用不代表客户端配置完整。
# CONSOLE_AUTHORITY_ORIGIN=http://100.64.0.10:8081
# PG 定时备份的容器名/账号（backup_db.py 容器内 pg_dump；密码走容器内 secret 不进 env）
# CONSOLE_PG_BACKUP_CONTAINER=console-postgres
# CONSOLE_PG_BACKUP_USER=console_admin
# CONSOLE_PG_BACKUP_DB=console

# NAS host storage (fixed outside checkout; containers still read /app/backup)
CONSOLE_HOST_BACKUP_DIR=/opt/.bak/console-stack
CONSOLE_HOST_TRASH_DIR=/opt/.trash/console-stack
